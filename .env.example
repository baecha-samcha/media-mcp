# Copy to ~/.config/media-mcp/server.env, mode 600. Never commit the real file.
# Set a random >=32-character key locally; this placeholder intentionally fails validation.
MEDIA_MCP_API_KEY=
MEDIA_MCP_HOST=127.0.0.1
MEDIA_MCP_PORT=8765
MEDIA_MCP_PUBLIC_BASE_URL=https://media.baecha.xyz
MEDIA_MCP_TEMP_DIR=/home/baecha/.cache/media-mcp
MEDIA_MCP_MEDIA_TTL=900
MEDIA_MCP_MAX_ITEM_BYTES=33554432
MEDIA_MCP_MAX_TOTAL_BYTES=134217728
# view_media inline image payload per MCP result (raw bytes before base64).
MEDIA_MCP_INLINE_MAX_BYTES=5242880
MEDIA_MCP_INLINE_FRAME_MAX_BYTES=2097152
MEDIA_MCP_MAX_ITEMS=20
MEDIA_MCP_CONCURRENCY=1
MEDIA_MCP_MAX_SESSIONS=4
MEDIA_MCP_EXTRACT_TIMEOUT=45
MEDIA_MCP_PREPARE_TIMEOUT=90
MEDIA_MCP_WORKER_MEMORY_MB=512
MEDIA_MCP_CLEANUP_INTERVAL=30
MEDIA_MCP_MAX_STREAMS=4
MEDIA_MCP_STREAM_TIMEOUT=120
# Optional dedicated Netscape cookie copy. yt-dlp may update this file.
# MEDIA_MCP_COOKIE_FILE=/home/baecha/.cache/media-mcp/instagram.cookies

# Optional OAuth: run .venv/bin/python scripts/configure_oauth.py locally.
# Appends hash/key to the EXISTING external env file, with a private backup.
# No raw owner password is stored. Both values are required to enable OAuth.
# MEDIA_MCP_OWNER_PASSWORD_HASH=<scrypt hash generated by setup script>
# MEDIA_MCP_OAUTH_STORAGE_KEY=<Fernet key generated by setup script>
# Issuer = MEDIA_MCP_PUBLIC_BASE_URL; resource = that origin + /mcp.
# Exact comma-separated HTTPS callbacks; no wildcard, query or fragment.
# MEDIA_MCP_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# Set 1 for new connections without automatic expiry (revocation still works).
# MEDIA_MCP_OAUTH_PERSISTENT_GRANTS=0
# MEDIA_MCP_OAUTH_ACCESS_TTL=900
# MEDIA_MCP_OAUTH_REFRESH_TTL=2592000
# MEDIA_MCP_OAUTH_CODE_TTL=120
# Default: MEDIA_MCP_TEMP_DIR/oauth-v1, within existing systemd writable path.
# MEDIA_MCP_OAUTH_STORE_DIR=/home/baecha/.cache/media-mcp/oauth-v1
